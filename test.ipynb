   "source": [
    "from qiskit import QuantumCircuit, transpile\n",
    "from qiskit_aer import AerSimulator\n",
    "\n",
    "qc = QuantumCircuit(2)\n",
    "qc.h(0)\n",
    "qc.cx(0, 1)\n",
    "qc.measure_all()\n",
    "\n",
    "sim = AerSimulator()\n",
    "print(sim.run(transpile(qc, sim), shots=1000).result().get_counts())\n",
    "qc.draw(\"mpl\")\n"
   ]
  }
 ],
